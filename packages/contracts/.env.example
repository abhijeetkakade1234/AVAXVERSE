# AVAXVERSE Contracts Environment Template
# Copy to: packages/contracts/.env
#
# IMPORTANT:
# - Never commit real private keys.
# - Use a dedicated deployer wallet with limited funds.

# Deployer private key (EOA used by Hardhat for deploy/upgrade).
# Format: 0x + 64 hex chars
# Source: export from your wallet (MetaMask/Hardware signer flow).
DEPLOYER_PRIVATE_KEY=

# Avalanche Fuji RPC endpoint.
# You can use public RPC or provider RPC (Alchemy/Ankr/QuickNode).
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Avalanche Mainnet C-Chain RPC endpoint.
MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Snowtrace API key for contract verification.
# Get it from: https://snowtrace.io/myapikey
SNOWTRACE_API_KEY=

# Mediator wallet for escrow dispute resolution (MVP).
# Use your own admin wallet for now.
MEDIATOR_ADDRESS=

# Backup mediator wallet.
# On Fuji/mainnet this must be different from MEDIATOR_ADDRESS.
MEDIATOR_BACKUP_ADDRESS=

# Timelock config (optional in MVP fast mode).
# 0 disables timelock deployment.
# 172800 = 48 hours.
TIMELOCK_DELAY_SEC=0

# Timelock proposer/executor/admin wallet.
# Usually your admin multisig or admin EOA.
TIMELOCK_ADMIN_ADDRESS=

# Fresh deploy safety switch for Fuji/Mainnet.
# Leave unset by default.
# Set to true only when you intentionally want NEW proxies and data reset.
# For normal logic changes with data preserved, use upgrade scripts instead.
ALLOW_FRESH_DEPLOY=

# Gas report toggle for tests.
REPORT_GAS=false
