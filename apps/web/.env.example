# AVAXVERSE Web App Environment Template
# Copy this file to:
# - .env.local   (local dev)
# - .env.testnet (Fuji deploy config)
# - .env.mainnet (Mainnet deploy config)
#
# Contract addresses are written automatically after deploy by:
#   packages/contracts/scripts/update-env.ts
# If needed, you can set them manually from:
#   packages/contracts/deployments/<network>.json

# WalletConnect v2 project id (required by RainbowKit/wagmi wallet modal).
# Get it from: https://cloud.reown.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# IdentityRegistry proxy address (UUPS proxy, not implementation).
NEXT_PUBLIC_IDENTITY_REGISTRY=

# ReputationToken proxy address.
NEXT_PUBLIC_REPUTATION_TOKEN=

# EscrowFactory proxy address.
NEXT_PUBLIC_ESCROW_FACTORY=

# AVAXToken proxy address.
NEXT_PUBLIC_AVAX_TOKEN=

# AVAXGovernor contract address.
# In mission-only deploy this can be 0x000...000.
NEXT_PUBLIC_AVAX_GOVERNOR=

# Frontend network mode:
# - localhost (hardhat local)
# - testnet   (Avalanche Fuji)
# - mainnet   (Avalanche C-Chain)
NEXT_PUBLIC_NETWORK=localhost

# Feature flags for this release.
# Keep false for mission-only mode.
NEXT_PUBLIC_ENABLE_DISPUTES=false
NEXT_PUBLIC_ENABLE_GOVERNANCE=false
